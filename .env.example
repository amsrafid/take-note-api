# Server
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes

# JWT — use a long, random secret (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS — comma-separated list of allowed origins. Leave empty to allow all.
CORS_ORIGIN=
